OPSHUB_BACKEND_URL=
OPSHUB_HUB_ID=
OPSHUB_HUB_TOKEN=
OPSHUB_TEMPLATE_DIR=
OPSHUB_WORK_DIR=
# Optional; ANDROID (default) or WEB.
OPSHUB_PLATFORM=
# A real, installed WebdriverIO project (wdio.conf.ts and/or wdio.web.conf.ts, tsconfig.json,
# node_modules) that every execution's rendered spec is run against - e.g. the local
# mobile_script/ directory. Required for BOTH platforms - a WEB Hub needs the same pinned
# Node/dependencies as ANDROID, just wdio.web.conf.ts instead of wdio.conf.ts. Without this
# the runner has no config or dependencies to actually run a spec with.
OPSHUB_WDIO_PROJECT_DIR=
# Node.js 20+ binary used to run the pinned WebdriverIO CLI directly - bypassing whatever
# `node` (if any, and whatever version) happens to be first on PATH.
OPSHUB_NODE_EXECUTABLE=
