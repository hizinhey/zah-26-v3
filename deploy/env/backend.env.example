# Copy this file to deploy/env/backend.env and fill in real secrets.
# deploy/env/backend.env is untracked (see .gitignore) and must never be
# committed. The Compose file loads it with `env_file:` on the backend
# service only — it is not passed to nginx or Postgres directly.
#
# preflight.sh checks that this file exists and that each variable name
# below is present; it never prints or logs the values themselves.

# --- Database (also read directly by the postgres service via POSTGRES_*) ---
POSTGRES_DB=opshub
POSTGRES_USER=opshub
POSTGRES_PASSWORD=change-me-to-a-strong-random-password

# --- Hub authentication ---
# Shared bearer token the Local Hub presents on /api/v1/hubs/* and
# /ws/v1/hubs/{hubId}. Generate with: openssl rand -hex 32
OPSHUB_HUB_TOKEN=change-me-to-a-random-hub-token
OPSHUB_HUB_POLL_WAIT_CAP_SECONDS=25

# --- Evidence uploads ---
OPSHUB_EVIDENCE_MAX_BYTES=10485760

# --- Gemini text/thumbnail validation (optional; leave blank to disable) ---
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash-lite
GEMINI_BASE_URL=https://generativelanguage.googleapis.com
